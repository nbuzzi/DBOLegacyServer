<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)..\..\ExecutionEnv</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>.\\config\\QueryServer.ini</LocalDebuggerCommandArguments>
    <RemoteDebuggerWorkingDirectory>$(ProjectDir)..\..\ExecutionEnv</RemoteDebuggerWorkingDirectory>
    <RemoteDebuggerCommandArguments>.\\config\\QueryServer.ini</RemoteDebuggerCommandArguments>
    <RemoteDebuggerConnection>RemoteWithAuthentication</RemoteDebuggerConnection>
    <RemoteDebuggerCommand>$(TargetPath)</RemoteDebuggerCommand>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)..\..\ExecutionEnv</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>.\\config\\QueryServer.ini</LocalDebuggerCommandArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)..\..\ExecutionEnv</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>.\\config\\QueryServer.ini</LocalDebuggerCommandArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)..\..\ExecutionEnv</LocalDebuggerWorkingDirectory>
    <LocalDebuggerCommandArguments>.\\config\\QueryServer.ini</LocalDebuggerCommandArguments>
  </PropertyGroup>
</Project>
