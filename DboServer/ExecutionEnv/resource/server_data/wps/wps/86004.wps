				Param( "dir x", 1.0 )
				Param( "dir z", 0.0 )
				Param( "no spawn wait", "true" )
			--]
			End()

			Action( "add mob" )
			--[
				Param( "index", 68131412 )
				Param( "group", 86021 )
				Param( "loc x", -160.0 )
				Param( "loc y", 112.0 )
				Param( "loc z", 20.0 )
				Param( "dir x", -1.0 )
				Param( "dir z", 0.0 )
				Param( "no spawn wait", "true" )
			--]
			End()

			-- Wait 20 seconds
			Action( "wait" )
			--[
				Condition( "check time" )
				--[
					Param( "time", 20 )
				--]
				End()
			--]
			End()

			-- Remove Eggs
			Action("remove mobgroup")
			--[
				Param( "group", 86011 )
				Param( "type", "clear" )
			--]
			End()
		--]
		End()

		-- check if boss is defeated
		Action( "wait" )
		--[
			Condition( "check mobgroup" )
			--[
				Param( "group", 86012 )
				Param( "count", 0 )
			--]
			End()
		--]
		End()

	--]
	End()

	-- Clean up remaining mobs after boss death
	Action("remove mobgroup")
	--[
		Param( "group", 86003 )
		Param( "type", "clear" )
	--]
	End()

	Action("remove mobgroup")
	--[
		Param( "group", 86006 )
		Param( "type", "clear" )
	--]
	End()

	Action("remove mobgroup")
	--[
		Param( "group", 86011 )
		Param( "type", "clear" )
	--]
	End()

	Action("remove mobgroup")
	--[
		Param( "group", 86020 )
		Param( "type", "clear" )
	--]
	End()

	Action("remove mobgroup")
	--[
		Param( "group", 86021 )
		Param( "type", "clear" )
	--]
	End()

--]
End()

