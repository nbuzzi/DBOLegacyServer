<mah:MetroWindow x:Class="DBOServerMonitor.DmpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Crash Dumps" Height="720" Width="1080" Background="{DynamicResource Brush.Background}">
  <Grid Margin="8" Background="{DynamicResource Brush.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="2*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Dumps found:" VerticalAlignment="Center"/>
      <Button Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
      <Button Content="Enable LocalDumps" Margin="8,0,0,0" Click="EnableDumps_Click"/>
      <Button Content="Open in WinDbg" Margin="16,0,0,0" Click="OpenWinDbg_Click"/>
      <Button Content="Open in Visual Studio" Margin="8,0,0,0" Click="OpenVS_Click"/>
      <Button Content="Analyze (!analyze -v)" Margin="8,0,0,0" Click="Analyze_Click"/>
    </StackPanel>
    <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
        <DataGridTextColumn Header="App" Binding="{Binding App}" Width="160"/>
        <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMB, StringFormat={}{0:N1}}" Width="120"/>
        <DataGridTextColumn Header="Created (local)" Binding="{Binding CreatedLocal, StringFormat={}{0:G}}" Width="220"/>
      </DataGrid.Columns>
    </DataGrid>
    <GroupBox Grid.Row="2" Header="Analysis Output" Margin="0,8,0,0">
      <ScrollViewer>
        <TextBox x:Name="Output" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
      </ScrollViewer>
    </GroupBox>
  </Grid>
</mah:MetroWindow>
