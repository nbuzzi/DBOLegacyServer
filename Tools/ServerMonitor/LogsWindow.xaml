<mah:MetroWindow x:Class="DBOServerMonitor.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    Title="Logs" Height="720" Width="1080" Background="{DynamicResource Brush.Background}">
  <Grid Background="{DynamicResource Brush.Background}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="8" Grid.ColumnSpan="2">
      <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="SearchBox" Width="320" Margin="0,0,6,0"/>
      <Button Content="Find" Click="Find_Click"/>
      <Separator Width="12"/>
      <CheckBox x:Name="ChkInfo" Content="Info" IsChecked="True" Margin="8,0"/>
      <CheckBox x:Name="ChkWarn" Content="Warn" IsChecked="True" Margin="8,0"/>
      <CheckBox x:Name="ChkError" Content="Error" IsChecked="True" Margin="8,0"/>
      <Separator Width="12"/>
      <CheckBox x:Name="ChkFollow" Content="Follow" Margin="8,0"/>
    </StackPanel>

    <TreeView x:Name="Tree" Grid.Row="1" Margin="8" SelectedItemChanged="Tree_SelectedItemChanged">
      <!-- Items: App -> Date (YYYY-MM-DD) -> files -->
    </TreeView>

    <Grid Grid.Row="1" Grid.Column="1" Margin="8">
      <RichTextBox x:Name="LogRtb" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"/>
    </Grid>
  </Grid>
</mah:MetroWindow>
